[sub_resource type="GDScript" id="GDScript_2rgyr"]
script/source = "
extends CharacterBody2D

# ==========================================
# CONFIGURAÇÕES DO PERSONAGEM
# ==========================================

@export var speed: float = 200.0
@export var jump_velocity: float = -300.0

@export var max_health: int = 3
var health: int

var gravity: float = float(
	ProjectSettings.get_setting(\"physics/2d/default_gravity\")
)

var facing_direction: float = 1.0

# ==========================================
# CONFIGURAÇÕES DO PULO
# ==========================================

@export var jump_horizontal_speed: float = 200.0

var is_jumping: bool = false

# ==========================================
# CONFIGURAÇÕES DO ATAQUE
# ==========================================

@export var attack_cooldown: float = 0.35
const ATTACK_DAMAGE = 1

var cooldown_time_left: float = 0.0
var is_attacking: bool = false
var already_hit: Array = []

# ==========================================
# CONFIGURAÇÕES DO KNOCKBACK
# ==========================================

@export var knockback_force: float = 300.0
@export var knockback_duration: float = 0.2

var knockback_velocity: Vector2 = Vector2.ZERO
var knockback_time_left: float = 0.0

# ==========================================
# ESTADOS
# ==========================================

var is_dead: bool = false

# ==========================================
# REFERÊNCIAS
# ==========================================

@onready var animated_sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var attack_area: Area2D = $Area2D


func _ready() -> void:
	health = max_health

	attack_area.monitoring = false

	attack_area.body_entered.connect(_on_attack_body_entered)
	animated_sprite.animation_finished.connect(_on_animação_animation_finished)

	animated_sprite.play(\"idle\")


# ==========================================
# MOVIMENTAÇÃO
# ==========================================

func _physics_process(delta: float) -> void:

	if is_dead:
		return

	# GRAVIDADE
	if not is_on_floor():
		velocity.y += gravity * delta

	# DIREÇÃO
	var direction := Input.get_axis(\"move_left\", \"move_right\")

	# COOLDOWN DO ATAQUE
	if cooldown_time_left > 0:
		cooldown_time_left -= delta

	# KNOCKBACK
	if knockback_time_left > 0:
		velocity.x = knockback_velocity.x
		knockback_time_left = maxf(knockback_time_left - delta, 0.0)

	else:

		# ==================================
		# PULO
		# ==================================

		if (Input.is_action_just_pressed(\"jump\") or Input.is_action_just_pressed(\"ui_accept\")) and is_on_floor():

			velocity.y = jump_velocity
			is_jumping = true

			animated_sprite.play(\"jump\")

		# ==================================
		# ATAQUE
		# ==================================

		if Input.is_action_just_pressed(\"MouseATK\") and not is_attacking and cooldown_time_left <= 0:

			is_attacking = true
			cooldown_time_left = attack_cooldown

			already_hit.clear()

			attack_area.monitoring = true

			animated_sprite.play(\"attack\")

		# ==================================
		# MOVIMENTAÇÃO HORIZONTAL
		# ==================================

		if is_attacking:
			velocity.x = move_toward(velocity.x, 0, speed)

		elif direction != 0:

			velocity.x = direction * speed

			if direction < 0:
				facing_direction = -1
				animated_sprite.flip_h = true
				attack_area.position.x = -abs(attack_area.position.x)

			else:
				facing_direction = 1
				animated_sprite.flip_h = false
				attack_area.position.x = abs(attack_area.position.x)

		else:
			velocity.x = move_toward(velocity.x, 0, speed)

	# ==================================
	# ANIMAÇÕES
	# ==================================

	if not is_attacking and knockback_time_left <= 0:

		if not is_on_floor():
			if animated_sprite.animation != \"jump\":
				animated_sprite.play(\"jump\")

		elif direction != 0:
			if animated_sprite.animation != \"walk\":
				animated_sprite.play(\"walk\")

		else:
			if animated_sprite.animation != \"idle\":
				animated_sprite.play(\"idle\")

	# FINAL DO PULO
	if is_on_floor():
		is_jumping = false

	move_and_slide()


# ==========================================
# SISTEMA DE DANO RECEBIDO
# ==========================================

func take_damage(amount: int = 1, attacker_position: Vector2 = Vector2.ZERO) -> void:

	if is_dead:
		return

	health -= amount

	print(\"Vida do personagem: \", health)

	if attacker_position != Vector2.ZERO:

		var direction = (global_position - attacker_position).normalized()

		knockback_velocity = direction * knockback_force
		knockback_time_left = knockback_duration

		velocity = knockback_velocity

	if health <= 0:
		die()


# ==========================================
# MORTE
# ==========================================

func die() -> void:

	if is_dead:
		return

	is_dead = true
	is_attacking = false

	attack_area.monitoring = false

	velocity = Vector2.ZERO

	knockback_time_left = 0.0
	knockback_velocity = Vector2.ZERO

	animated_sprite.play(\"death\")

	print(\"O personagem morreu!\")


# ==========================================
# HITBOX DO ATAQUE
# ==========================================

func _on_attack_body_entered(body: Node2D) -> void:

	if body == self or body in already_hit:
		return

	if body.has_method(\"take_damage\"):

		already_hit.append(body)

		body.take_damage(ATTACK_DAMAGE, global_position)


# ==========================================
# FINAL DAS ANIMAÇÕES
# ==========================================

func _on_animação_animation_finished() -> void:

	if animated_sprite.animation == \"attack\":

		is_attacking = false

		attack_area.monitoring = false

		already_hit.clear()

		if is_on_floor():
			animated_sprite.play(\"idle\")
		else:
			animated_sprite.play(\"jump\")

	elif animated_sprite.animation == \"death\":

		velocity = Vector2.ZERO
"

