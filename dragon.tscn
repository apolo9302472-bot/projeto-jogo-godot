[sub_resource type="GDScript" id="GDScript_8nn35"]
script/source = "extends CharacterBody2D

enum State { WALK, TAKEOFF, FLIGHT, SPECIAL, DEAD }

@export var player: Node2D                         # arraste o player aqui (ou use grupo \"player\")
@export var max_hits: int = 15                     # golpes para morrer
@export var walk_speed: float = 60.0
@export var fly_speed: float = 150.0
@export var takeoff_rise_speed: float = 90.0
@export var takeoff_distance: float = 350.0        # distância para decolar
@export var attack_offset_x: float = 110.0         # distância horizontal do player ao atacar
@export var fly_height: float = 110.0              # altura acima do player ao atacar
@export var special_damage: int = 1
@export var special_damage_frame: int = 3          # frame do \"special\" em que o fogo causa dano
@export var special_cooldown: float = 2.0

@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var attack_area: Area2D = $AttackArea
@onready var body_shape: CollisionShape2D = $CollisionShape2D

var state: State = State.WALK
var health: int
var facing: int = 1            # 1 = direita, -1 = esquerda
var cooldown_left: float = 0.0
var damage_done: bool = false


func _ready() -> void:
	health = max_hits
	add_to_group(\"enemy\")
	if player == null:
		player = get_tree().get_first_node_in_group(\"player\")
	sprite.animation_finished.connect(_on_animation_finished)
	sprite.frame_changed.connect(_on_frame_changed)
	_change_state(State.WALK)


func _physics_process(delta: float) -> void:
	if state == State.DEAD or player == null:
		return

	cooldown_left = max(cooldown_left - delta, 0.0)

	# Só vira para o player quando NÃO está atacando
	if state != State.SPECIAL:
		_update_facing()

	match state:
		State.WALK:
			_state_walk()
		State.TAKEOFF:
			velocity = Vector2(0, -takeoff_rise_speed)
		State.FLIGHT:
			_state_flight()
		State.SPECIAL:
			velocity = Vector2.ZERO

	move_and_slide()


# ---------------- ESTADOS ----------------

func _state_walk() -> void:
	velocity = Vector2(facing * walk_speed, 0)
	var dist := absf(player.global_position.x - global_position.x)
	if dist <= takeoff_distance:
		_change_state(State.TAKEOFF)


func _state_flight() -> void:
	# Ponto onde o dragão fica para soltar o fogo: na frente do player, acima dele
	var target := Vector2(
		player.global_position.x - facing * attack_offset_x,
		player.global_position.y - fly_height
	)
	var to_target := target - global_position

	if to_target.length() <= 12.0:
		velocity = Vector2.ZERO
		if cooldown_left <= 0.0:
			_change_state(State.SPECIAL)
	else:
		velocity = to_target.normalized() * fly_speed


func _change_state(new_state: State) -> void:
	state = new_state
	match state:
		State.WALK:
			sprite.play(\"walk\")
		State.TAKEOFF:
			sprite.play(\"takeoff\")
		State.FLIGHT:
			sprite.play(\"flight\")
		State.SPECIAL:
			damage_done = false
			sprite.play(\"special\")
		State.DEAD:
			velocity = Vector2.ZERO
			body_shape.set_deferred(\"disabled\", true)
			attack_area.set_deferred(\"monitoring\", false)
			if sprite.sprite_frames.has_animation(\"dead\"):
				sprite.play(\"dead\")
			else:
				queue_free()


# ---------------- DIREÇÃO (ESQUERDA / DIREITA) ----------------

func _update_facing() -> void:
	var dir := player.global_position.x - global_position.x
	if absf(dir) > 4.0:
		facing = 1 if dir > 0 else -1
	sprite.flip_h = facing < 0          # sprite original olha para a direita
	attack_area.scale.x = facing        # espelha a área do fogo


# ---------------- ANIMAÇÕES ----------------

func _on_animation_finished() -> void:
	match state:
		State.TAKEOFF:
			_change_state(State.FLIGHT)
		State.SPECIAL:
			cooldown_left = special_cooldown
			_change_state(State.FLIGHT)
		State.DEAD:
			queue_free()


func _on_frame_changed() -> void:
	# Causa dano ao player apenas uma vez, no frame certo do \"special\"
	if state == State.SPECIAL and not damage_done and sprite.frame >= special_damage_frame:
		damage_done = true
		for body in attack_area.get_overlapping_bodies():
			if body.is_in_group(\"player\") and body.has_method(\"take_damage\"):
				body.take_damage(special_damage)


# ---------------- VIDA ----------------

# O player chama esta função cada vez que acerta o dragão
func take_hit(amount: int = 1) -> void:
	if state == State.DEAD:
		return
	health -= amount

	# efeito de dano
	sprite.modulate = Color(1, 0.4, 0.4)
	create_tween().tween_property(sprite, \"modulate\", Color.WHITE, 0.15)

	if health <= 0:
		_change_state(State.DEAD)
"

